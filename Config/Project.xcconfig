FL_BUNDLE_ID = org.forcelegacyui.app
APP_GROUP_IDENTIFIER = group.org.forcelegacyui.app
FL_ACCESS_MODE = app-group
PRODUCT_NAME = $(TARGET_NAME)
MARKETING_VERSION = 0.1.5
CURRENT_PROJECT_VERSION = 7
SDKROOT = iphoneos
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = minimal
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
GCC_C_LANGUAGE_STANDARD = gnu17
CODE_SIGN_STYLE = Automatic
GENERATE_INFOPLIST_FILE = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
SWIFT_EMIT_LOC_STRINGS = NO
HEADER_SEARCH_PATHS = $(inherited) "$(SRCROOT)/ForceLegacyUI/Bridge" "$(SRCROOT)/ForceLegacyUI/Vendor/worse_query"
SWIFT_OBJC_BRIDGING_HEADER = ForceLegacyUI/Bridge/ForceLegacyUI-Bridging-Header.h
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
#include? "Signing.local.xcconfig"
